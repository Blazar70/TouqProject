-- Touq — daily job that permanently deletes clinics trashed more than 7 days ago.
--
-- NOT a migration: it embeds a secret. Copy this file, fill in the
-- placeholders, and run it ONCE in the Supabase SQL editor.
-- Requires 0024 (pg_cron, pg_net) and the edge function secret
-- CRON_PURGE_SECRET set to the same value used below
-- (supabase secrets set CRON_PURGE_SECRET=...).
--
-- The function authenticates this call by the x-cron-secret header, not the
-- service-role key (see the comment at the top of
-- supabase/functions/admin-manage-clinic/index.ts for why).
--
-- Unverified: if the function is deployed with JWT verification on (the
-- Supabase default), the gateway rejects calls with no Authorization header
-- before the function runs. Either deploy with --no-verify-jwt, or add
-- 'Authorization', 'Bearer <ANON_KEY>' to the headers below.
--
-- To change or remove later:  select cron.unschedule('purge-expired-clinics');

select cron.schedule(
  'purge-expired-clinics',
  '0 3 * * *',
  $$
  select net.http_post(
    url := 'https://<PROJECT_REF>.supabase.co/functions/v1/admin-manage-clinic',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'x-cron-secret', '<CRON_PURGE_SECRET>'
    ),
    body := '{"action":"purge_expired"}'::jsonb
  );
  $$
);
