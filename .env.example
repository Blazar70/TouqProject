VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
# Crash reports (Sentry). Leave empty locally; set only as the staging site's Cloudflare build variable.
VITE_SENTRY_DSN=

# Server-side / script use only — never prefix with VITE_, never expose to the frontend.
# Bypasses all Row Level Security. Used by scripts/seed-admin.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/rebuild-db.mjs (Supabase -> Settings -> Database -> Connection string, URI)
DATABASE_URL=
